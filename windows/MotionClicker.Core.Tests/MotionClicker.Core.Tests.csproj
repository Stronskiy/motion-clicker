<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="../MotionClicker.Core/MotionClicker.Core.csproj" />
    <Compile Include="../MotionClicker.Windows/MonitorMapLayout.cs" Link="MonitorMapLayout.cs" />
    <Compile Include="../MotionClicker.Windows/WindowSizing.cs" Link="WindowSizing.cs" />
    <Compile Include="../MotionClicker.Windows/Recording/WindowsRecordingClock.cs" Link="WindowsRecordingClock.cs" />
    <Compile Include="../MotionClicker.Windows/Recording/WindowsPointerAdapter.cs" Link="WindowsPointerAdapter.cs" />
    <Compile Include="../MotionClicker.Windows/Recording/WindowsStreamTimeline.cs" Link="WindowsStreamTimeline.cs" />
    <Compile Include="../MotionClicker.Windows/Recording/WindowsHookWatchdog.cs" Link="WindowsHookWatchdog.cs" />
    <Compile Include="../MotionClicker.Windows/Recording/WindowsRecordingPlatform.cs" Link="WindowsRecordingPlatform.cs" />
    <Compile Include="../MotionClicker.Windows/Recording/WindowsRecordingController.cs" Link="WindowsRecordingController.cs" />
    <None Include="../../contracts/fixtures/recording/*.json" Link="fixtures/recording/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../contracts/fixtures/*.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
