{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recording.schema.json",
  "title": "Motion Clicker recording manifest version 1",
  "type": "object",
  "required": [
    "manifestVersion",
    "takeId",
    "state",
    "epochHostUs",
    "durationUs",
    "targets",
    "streams",
    "rawEventCount",
    "incompleteGroupIds",
    "warnings"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "takeId": {
      "$ref": "#/$defs/id"
    },
    "state": {
      "enum": [
        "completed",
        "interrupted",
        "failed"
      ]
    },
    "epochHostUs": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "durationUs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "project.schema.json#/$defs/monitorSlot"
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream"
      }
    },
    "rawEventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "incompleteGroupIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pointerTimingBasis": {
      "anyOf": [
        {
          "$ref": "#/$defs/pointerTimingBasis"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "$ref": "project.schema.json#/$defs/id"
    },
    "clockAnchor": {
      "type": "object",
      "required": [
        "sourceAnchorTicks",
        "hostAnchorUs",
        "ticksPerSecond"
      ],
      "properties": {
        "sourceAnchorTicks": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "hostAnchorUs": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "ticksPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": true
    },
    "gap": {
      "type": "object",
      "required": [
        "startUs",
        "endUs",
        "kind"
      ],
      "properties": {
        "startUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "endUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "kind": {
          "enum": [
            "leading",
            "dropped",
            "backpressure",
            "sourceFailure",
            "encoderFailure"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "stream": {
      "type": "object",
      "required": [
        "monitorSlotId",
        "relativePath",
        "clock",
        "encodedDurationUs",
        "frameCount",
        "gaps",
        "writerStatus",
        "gapCount",
        "gapJournalPath"
      ],
      "properties": {
        "monitorSlotId": {
          "$ref": "#/$defs/id"
        },
        "relativePath": {
          "type": "string",
          "pattern": "^media/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.mp4$"
        },
        "clock": {
          "$ref": "#/$defs/clockAnchor"
        },
        "mediaTimeZeroUs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "encodedDurationUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "frameCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          },
          "maxItems": 64
        },
        "writerStatus": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "failureReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "gapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gapJournalPath": {
          "type": "string",
          "pattern": "^takes/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/gaps\\.jsonl$"
        }
      },
      "additionalProperties": true
    },
    "capturedPointerEvent": {
      "type": "object",
      "required": [
        "hostTimeUs",
        "nativePosition",
        "kind",
        "isOwnInjected",
        "isControl"
      ],
      "properties": {
        "hostTimeUs": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "nativePosition": {
          "$ref": "project.schema.json#/$defs/point"
        },
        "kind": {
          "enum": [
            "move",
            "buttonDown",
            "buttonUp",
            "scroll"
          ]
        },
        "button": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right",
                "middle"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "deltaX": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "deltaY": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "isOwnInjected": {
          "type": "boolean"
        },
        "isControl": {
          "type": "boolean"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/pointerTiming"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "rawPointerRecord": {
      "type": "object",
      "required": [
        "sequence",
        "event",
        "timeUs"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "event": {
          "$ref": "#/$defs/capturedPointerEvent"
        },
        "timeUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "action": {
          "anyOf": [
            {
              "$ref": "project.schema.json#/$defs/recordedAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "atomicGroupId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "journalGapRecord": {
      "type": "object",
      "required": [
        "monitorSlotId",
        "gap"
      ],
      "properties": {
        "monitorSlotId": {
          "$ref": "#/$defs/id"
        },
        "gap": {
          "$ref": "#/$defs/gap"
        }
      }
    },
    "pointerTimingBasis": {
      "enum": [
        "nativeHostObservation"
      ]
    },
    "pointerTiming": {
      "type": "object",
      "required": [
        "basis",
        "hostClock",
        "packetClock",
        "packetUnits",
        "packetTimestamp",
        "ownerDelayUs"
      ],
      "properties": {
        "basis": {
          "$ref": "#/$defs/pointerTimingBasis"
        },
        "hostClock": {
          "enum": [
            "machAbsolute",
            "queryPerformanceCounter"
          ]
        },
        "packetClock": {
          "enum": [
            "cgEventTimestamp",
            "windowsLowLevelMouseTime"
          ]
        },
        "packetUnits": {
          "enum": [
            "nanoseconds",
            "milliseconds"
          ]
        },
        "packetTimestamp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "ownerDelayUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "oneOf": [
        {
          "properties": {
            "hostClock": {
              "const": "machAbsolute"
            },
            "packetClock": {
              "const": "cgEventTimestamp"
            },
            "packetUnits": {
              "const": "nanoseconds"
            }
          }
        },
        {
          "properties": {
            "hostClock": {
              "const": "queryPerformanceCounter"
            },
            "packetClock": {
              "const": "windowsLowLevelMouseTime"
            },
            "packetUnits": {
              "const": "milliseconds"
            },
            "packetTimestamp": {
              "maxLength": 10,
              "description": "Native UInt32 value; codecs also require <=4294967295."
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
