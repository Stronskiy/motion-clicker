{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recording.schema.json",
  "title": "Motion Clicker recording manifest version 1",
  "type": "object",
  "required": [
    "manifestVersion",
    "takeId",
    "state",
    "epochHostUs",
    "durationUs",
    "targets",
    "streams",
    "rawEventCount",
    "incompleteGroupIds",
    "warnings"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "takeId": {
      "$ref": "#/$defs/id"
    },
    "state": {
      "enum": [
        "completed",
        "interrupted",
        "failed"
      ]
    },
    "epochHostUs": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "durationUs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "project.schema.json#/$defs/monitorSlot"
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream"
      }
    },
    "rawEventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "incompleteGroupIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "$ref": "project.schema.json#/$defs/id"
    },
    "clockAnchor": {
      "type": "object",
      "required": [
        "sourceAnchorTicks",
        "hostAnchorUs",
        "ticksPerSecond"
      ],
      "properties": {
        "sourceAnchorTicks": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "hostAnchorUs": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "ticksPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": true
    },
    "gap": {
      "type": "object",
      "required": [
        "startUs",
        "endUs",
        "kind"
      ],
      "properties": {
        "startUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "endUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "kind": {
          "enum": [
            "leading",
            "dropped",
            "backpressure",
            "sourceFailure",
            "encoderFailure"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "stream": {
      "type": "object",
      "required": [
        "monitorSlotId",
        "relativePath",
        "clock",
        "encodedDurationUs",
        "frameCount",
        "gaps",
        "writerStatus",
        "gapCount",
        "gapJournalPath"
      ],
      "properties": {
        "monitorSlotId": {
          "$ref": "#/$defs/id"
        },
        "relativePath": {
          "type": "string",
          "pattern": "^media/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.mp4$"
        },
        "clock": {
          "$ref": "#/$defs/clockAnchor"
        },
        "mediaTimeZeroUs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "encodedDurationUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "frameCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          },
          "maxItems": 64
        },
        "writerStatus": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "failureReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "gapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gapJournalPath": {
          "type": "string",
          "pattern": "^takes/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/gaps\\.jsonl$"
        }
      },
      "additionalProperties": true
    },
    "capturedPointerEvent": {
      "type": "object",
      "required": [
        "hostTimeUs",
        "nativePosition",
        "kind",
        "isOwnInjected",
        "isControl"
      ],
      "properties": {
        "hostTimeUs": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "nativePosition": {
          "$ref": "project.schema.json#/$defs/point"
        },
        "kind": {
          "enum": [
            "move",
            "buttonDown",
            "buttonUp",
            "scroll"
          ]
        },
        "button": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right",
                "middle"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "deltaX": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "deltaY": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "isOwnInjected": {
          "type": "boolean"
        },
        "isControl": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "rawPointerRecord": {
      "type": "object",
      "required": [
        "sequence",
        "event",
        "timeUs"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "event": {
          "$ref": "#/$defs/capturedPointerEvent"
        },
        "timeUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "action": {
          "anyOf": [
            {
              "$ref": "project.schema.json#/$defs/recordedAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "atomicGroupId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "journalGapRecord": {
      "type": "object",
      "required": [
        "monitorSlotId",
        "gap"
      ],
      "properties": {
        "monitorSlotId": {
          "$ref": "#/$defs/id"
        },
        "gap": {
          "$ref": "#/$defs/gap"
        }
      }
    }
  }
}
